[Unit]
Description=DiceBot QQ lobby bot
After=network-online.target dicebot-api.service
Wants=network-online.target dicebot-api.service

[Service]
User=dicebot
Group=dicebot
WorkingDirectory=/opt/dicebot/current
EnvironmentFile=/etc/dicebot/runtime.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/dicebot/venv/bin/python bot.py
Restart=on-failure
RestartSec=5
MemoryMax=300M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/dicebot
UMask=0027

[Install]
WantedBy=multi-user.target
